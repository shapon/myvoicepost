{
  "info": {
    "name": "MyVoicePost Production API",
    "description": "API collection for testing MyVoicePost production server at www.myvoicepost.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://www.myvoicepost.com",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "JWT token from login - set this after logging in"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    console.log('Token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (Auth)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Forgot Password (Web)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your_email@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Request a password reset for web app. Returns a reset token (15 min expiry)."
          }
        },
        {
          "name": "Reset Password (Web)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"RESET_TOKEN_FROM_FORGOT_PASSWORD\",\n  \"newPassword\": \"newpassword123\",\n  \"confirmPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            },
            "description": "Reset password using the token from forgot-password endpoint."
          }
        }
      ]
    },
    {
      "name": "Public API (No Auth)",
      "item": [
        {
          "name": "Login (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    console.log('Token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"your_username_or_email\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "login"]
            },
            "description": "Login with username or email. The identifier field accepts either."
          }
        },
        {
          "name": "Register (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    console.log('Token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "register"]
            },
            "description": "Register a new user account. Returns JWT token on success."
          }
        },
        {
          "name": "Forgot Password (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your_email@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "forgot-password"]
            },
            "description": "Request a password reset. Returns a reset token (15 min expiry)."
          }
        },
        {
          "name": "Reset Password (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"RESET_TOKEN_FROM_FORGOT_PASSWORD\",\n  \"newPassword\": \"newpassword123\",\n  \"confirmPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "reset-password"]
            },
            "description": "Reset password using the token from forgot-password endpoint."
          }
        },
        {
          "name": "Transcribe Audio (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio\": \"BASE64_ENCODED_AUDIO_HERE\",\n  \"mimeType\": \"audio/mp4\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/transcribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "transcribe"]
            },
            "description": "Transcribe audio to text. Replace BASE64_ENCODED_AUDIO_HERE with actual base64 audio data."
          }
        },
        {
          "name": "Polish Text (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"hello how are you doing today\",\n  \"language\": \"en\",\n  \"outputFormat\": \"professional\",\n  \"outputType\": \"message\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/polish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "polish"]
            },
            "description": "Polish/improve text. outputFormat: professional, casual, formal, friendly. outputType: message, email, social, note"
          }
        },
        {
          "name": "Translate Text (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, how are you?\",\n  \"sourceLanguage\": \"en\",\n  \"targetLanguage\": \"es\",\n  \"outputFormat\": \"professional\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/translate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "translate"]
            },
            "description": "Translate text from source to target language. Languages: en, es, fr, de, it, pt, zh, ja, ko, ar, hi, ru"
          }
        }
      ]
    },
    {
      "name": "Authenticated API (Requires Token)",
      "item": [
        {
          "name": "Transcribe Audio (Auth)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio\": \"BASE64_ENCODED_AUDIO_HERE\",\n  \"mimeType\": \"audio/mp4\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/m/transcribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "m", "transcribe"]
            }
          }
        },
        {
          "name": "Polish Text (Auth)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"hello how are you doing today\",\n  \"language\": \"en\",\n  \"outputFormat\": \"professional\",\n  \"outputType\": \"message\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/m/polish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "m", "polish"]
            }
          }
        },
        {
          "name": "Translate Text (Auth)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, how are you?\",\n  \"sourceLanguage\": \"en\",\n  \"targetLanguage\": \"es\",\n  \"outputFormat\": \"professional\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/m/translate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "m", "translate"]
            }
          }
        },
        {
          "name": "Get Saved Items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/m/saved-items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "m", "saved-items"]
            }
          }
        },
        {
          "name": "Create Saved Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"polish\",\n  \"originalText\": \"hello how are you\",\n  \"polishedText\": \"Hello! How are you doing?\",\n  \"sourceLanguage\": \"en\",\n  \"outputFormat\": \"professional\",\n  \"outputType\": \"message\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/m/saved-items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "m", "saved-items"]
            }
          }
        },
        {
          "name": "Update Saved Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalText\": \"updated text here\",\n  \"polishedText\": \"Updated polished text\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/m/saved-items/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "m", "saved-items", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "ITEM_ID_HERE"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Saved Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/m/saved-items/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "m", "saved-items", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "ITEM_ID_HERE"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    }
  ]
}
