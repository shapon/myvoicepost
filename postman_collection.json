{
  "info": {
    "name": "MyVoicePost API",
    "description": "Complete API collection for MyVoicePost. Base URL: https://www.myvoicepost.com\n\nPREFIX CONVENTIONS:\n  /api/v1/p/   Public — no auth required (guest access)\n  /api/v1/a/   Authenticated — requires Bearer token\n  /api/v1/wp/  Web-only public (not used by mobile)\n\nAUTH: After running 'Login', the authToken variable is auto-saved and used by all authenticated requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://www.myvoicepost.com",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "JWT token — auto-populated by Login request test script"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Returns {status:'ok'} if server is running."
          }
        }
      ]
    },
    {
      "name": "Public — Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    console.log('Token saved:', jsonData.token.substring(0, 20) + '...');",
                  "} else {",
                  "    console.log('No token in response:', JSON.stringify(jsonData));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "auth", "login"]
            },
            "description": "Login with email + password. Returns JWT token. Test script auto-saves token to authToken variable.\n\nResponse: { success, token, user: { id, email, name, role } }"
          }
        },
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('authToken', jsonData.token);",
                  "    console.log('Token saved from signup');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"New User\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "auth", "signup"]
            },
            "description": "Register a new user. Requires OTP from mail_otp first.\n\nResponse: { success, token, user: { id, email, name, role } }"
          }
        },
        {
          "name": "Send OTP (Mail Verification)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/mail_otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "mail_otp"]
            },
            "description": "Send a one-time verification code to the given email address. Required before signup.\n\nResponse: { success, message }"
          }
        },
        {
          "name": "Google Sign-In",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"GOOGLE_ID_TOKEN_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "auth", "google"]
            },
            "description": "Sign in using a Google ID token (from Google Sign-In button). Creates account if first time.\n\nResponse: { success, token, user: { id, email, name, role } }"
          }
        }
      ]
    },
    {
      "name": "Public — Transcription",
      "item": [
        {
          "name": "Transcribe Audio — Auto-Detect Language",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio\": \"BASE64_ENCODED_AUDIO_HERE\",\n  \"mimeType\": \"audio/mp4\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/transcribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "transcribe"]
            },
            "description": "Transcribe audio with automatic language detection. Use when language is unknown.\n\nRequest: { audio: base64, mimeType: 'audio/mp4'|'audio/webm'|'audio/m4a' }\n\nResponse: { success, originalText, detectedLanguage, confidence }"
          }
        },
        {
          "name": "Transcribe Audio — Language Specific",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio\": \"BASE64_ENCODED_AUDIO_HERE\",\n  \"mimeType\": \"audio/mp4\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/transcribe_l",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "transcribe_l"]
            },
            "description": "Transcribe audio with a known language for higher accuracy. Use when language is already selected.\n\nRequest: { audio: base64, mimeType, language: 'en'|'es'|'fr'|'de'|'zh'|... }\n\nResponse: { success, originalText, language, confidence }"
          }
        }
      ]
    },
    {
      "name": "Public — Polish & Translate",
      "item": [
        {
          "name": "Polish Text",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"hello how are you doing today i hope you are well\",\n  \"language\": \"en\",\n  \"outputFormat\": \"professional\",\n  \"outputType\": \"message\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/polish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "polish"]
            },
            "description": "Polish/improve text for guests (no auth required). Field name is 'text'.\n\noutputFormat: 'professional' | 'casual' | 'formal' | 'friendly'\noutputType: 'general' | 'message' | 'email' | 'social' | 'note'\n\nResponse: { success, originalText, polishedText, language, outputFormat, outputType }"
          }
        },
        {
          "name": "Translate Text",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello, how are you?\",\n  \"sourceLanguage\": \"en\",\n  \"targetLanguage\": \"es\",\n  \"outputFormat\": \"professional\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/translate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "translate"]
            },
            "description": "Translate text for guests (no auth required). Field name is 'text'.\n\nsourceLanguage / targetLanguage: 'en' | 'es' | 'fr' | 'de' | 'it' | 'pt' | 'zh' | 'ja' | 'ko' | 'ar' | 'hi' | 'ru' | ...\n\nResponse: { success, originalText, translatedText, polishedText, sourceLanguage, targetLanguage, outputFormat }"
          }
        }
      ]
    },
    {
      "name": "Public — Tone & Process",
      "item": [
        {
          "name": "Get Tone Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/tone-categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "tone-categories"]
            },
            "description": "Returns all available tone transformation categories and their options.\n\nResponse: { success, categories: [ { id, name, tones: [...] } ] }"
          }
        },
        {
          "name": "Transform Tone",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"I need this done by tomorrow.\",\n  \"tone\": \"friendly\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/transform-tone",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "transform-tone"]
            },
            "description": "Rewrite text in a different tone (guest, no auth).\n\nResponse: { success, originalText, transformedText, tone }"
          }
        },
        {
          "name": "Process URL (Public)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/article\",\n  \"targetLanguage\": \"es\",\n  \"outputFormat\": \"professional\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/process-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "process-url"]
            },
            "description": "Extract text from a URL and translate/polish it (guest, no auth).\n\nResponse: { success, originalText, processedText, sourceLanguage, targetLanguage }"
          }
        }
      ]
    },
    {
      "name": "Public — Plans & Stripe Config",
      "item": [
        {
          "name": "Get Plans",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "plans"]
            },
            "description": "Returns available subscription plans.\n\nResponse: { success, plans: [ { id, name, price, interval, features } ] }"
          }
        },
        {
          "name": "Get Stripe Config",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/p/stripe-config",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "p", "stripe-config"]
            },
            "description": "Returns Stripe publishable key for client-side Stripe initialization.\n\nResponse: { publishableKey }"
          }
        }
      ]
    },
    {
      "name": "Authenticated — Auth",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "auth", "me"]
            },
            "description": "Returns the authenticated user's profile.\n\nResponse: { success, user: { id, email, name, role, subscription } }"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "auth", "logout"]
            },
            "description": "Invalidates the current JWT session.\n\nResponse: { success, message }"
          }
        },
        {
          "name": "Get User Role",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/user-role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "user-role"]
            },
            "description": "Returns the user's current role (GUEST, TRIAL, USER, ADMIN).\n\nResponse: { success, role, hasAccess }"
          }
        }
      ]
    },
    {
      "name": "Authenticated — Transcription",
      "item": [
        {
          "name": "Transcribe Audio — Auto-Detect Language (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio\": \"BASE64_ENCODED_AUDIO_HERE\",\n  \"mimeType\": \"audio/mp4\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/transcribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "transcribe"]
            },
            "description": "Transcribe audio with automatic language detection (authenticated). Results may be saved to user history.\n\nRequest: { audio: base64, mimeType }\n\nResponse: { success, originalText, detectedLanguage, confidence }"
          }
        },
        {
          "name": "Transcribe Audio — Language Specific (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"audio\": \"BASE64_ENCODED_AUDIO_HERE\",\n  \"mimeType\": \"audio/mp4\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/transcribe_l",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "transcribe_l"]
            },
            "description": "Transcribe audio with known language for highest accuracy (authenticated).\n\nRequest: { audio: base64, mimeType, language: 'en'|'es'|... }\n\nResponse: { success, originalText, language, confidence }"
          }
        },
        {
          "name": "Transcribe from URL (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/audio.mp3\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/transcribe-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "transcribe-url"]
            },
            "description": "Transcribe audio from a remote URL.\n\nResponse: { success, originalText, language }"
          }
        },
        {
          "name": "Transcribe Audio File Upload (Auth)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "audio", "type": "file", "src": "", "description": "Audio file to transcribe" },
                { "key": "language", "value": "en", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/transcribe-file",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "transcribe-file"]
            },
            "description": "Transcribe an audio file uploaded as multipart/form-data.\n\nResponse: { success, originalText, language }"
          }
        }
      ]
    },
    {
      "name": "Authenticated — Polish & Translate",
      "item": [
        {
          "name": "Polish Text (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalText\": \"hello how are you doing today i hope you are well\",\n  \"language\": \"en\",\n  \"outputFormat\": \"professional\",\n  \"outputType\": \"message\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/polish",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "polish"]
            },
            "description": "Polish/improve text for authenticated users. Field name is 'originalText' (differs from public 'text').\n\noutputFormat: 'professional' | 'casual' | 'formal' | 'friendly'\noutputType: 'general' | 'message' | 'email' | 'social' | 'note'\n\nResponse: { success, originalText, polishedText, language, outputFormat, outputType, savedTextId? }"
          }
        },
        {
          "name": "Translate Text (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalText\": \"Hello, how are you?\",\n  \"sourceLanguage\": \"en\",\n  \"targetLanguage\": \"es\",\n  \"outputFormat\": \"professional\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/translate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "translate"]
            },
            "description": "Translate text for authenticated users. Field name is 'originalText' (differs from public 'text').\n\nResponse: { success, originalText, translatedText, polishedText, sourceLanguage, targetLanguage, outputFormat, savedTextId? }"
          }
        },
        {
          "name": "Transform Tone (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"I need this done by tomorrow.\",\n  \"tone\": \"friendly\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/transform-tone",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "transform-tone"]
            },
            "description": "Rewrite text in a different tone (authenticated).\n\nResponse: { success, originalText, transformedText, tone }"
          }
        },
        {
          "name": "Get Tone Categories (Auth)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/tone-categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "tone-categories"]
            },
            "description": "Returns all available tone transformation categories (authenticated version).\n\nResponse: { success, categories: [ { id, name, tones: [...] } ] }"
          }
        }
      ]
    },
    {
      "name": "Authenticated — Process & Generate",
      "item": [
        {
          "name": "Process URL (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/article\",\n  \"targetLanguage\": \"es\",\n  \"outputFormat\": \"professional\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/process-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "process-url"]
            },
            "description": "Extract text from a URL and translate/polish it (authenticated, results saved).\n\nResponse: { success, originalText, processedText, sourceLanguage, targetLanguage }"
          }
        },
        {
          "name": "Generate Image (Auth)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"A serene mountain lake at sunset\",\n  \"style\": \"photorealistic\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/generate-image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "generate-image"]
            },
            "description": "Generate an AI image from a text prompt (authenticated).\n\nResponse: { success, imageUrl, prompt }"
          }
        }
      ]
    },
    {
      "name": "Authenticated — Saved Texts",
      "item": [
        {
          "name": "List Saved Texts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/saved-texts?type=polish&limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "saved-texts"],
              "query": [
                { "key": "type", "value": "polish", "description": "Filter: 'polish' | 'translate'" },
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "List saved texts for the authenticated user.\n\nQuery params: type ('polish'|'translate'), limit, offset\n\nResponse: { success, savedTexts: [ { id, type, originalText, polishedText, translatedText, language, createdAt, ... } ] }"
          }
        },
        {
          "name": "Get Saved Text by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/saved-texts/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "saved-texts", ":id"],
              "variable": [{ "key": "id", "value": "SAVED_TEXT_ID_HERE" }]
            },
            "description": "Get a single saved text by its ID.\n\nResponse: { success, savedText: { id, type, originalText, polishedText, ... } }"
          }
        },
        {
          "name": "Create Saved Text",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"polish\",\n  \"originalText\": \"hello how are you\",\n  \"polishedText\": \"Hello! How are you doing today?\",\n  \"language\": \"en\",\n  \"outputFormat\": \"professional\",\n  \"outputType\": \"message\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/a/saved-texts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "a", "saved-texts"]
            },
            "description": "Save a polish or translate result to the user's history.\n\ntype: 'polish' | 'translate'\nFor translate, also include: translatedText, sourceLanguage, targetLanguage\n\nResponse: { success, savedText: { id, ... } }"
          }
        },
        {
          "name": "Update Saved Text",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
